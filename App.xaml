<Application x:Class="DailyQuest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="InkBrush" Color="#17212B" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#5F6B7A" />
        <SolidColorBrush x:Key="TertiaryInkBrush" Color="#7D8896" />
        <SolidColorBrush x:Key="IvoryBrush" Color="#FFFDF5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3A715A" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#315F4C" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#284E3F" />
        <SolidColorBrush x:Key="AccentTintBrush" Color="#263A715A" />
        <SolidColorBrush x:Key="GlassElevatedBrush" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="GlassCardBrush" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="GlassSubtleBrush" Color="#78FFFFFF" />
        <SolidColorBrush x:Key="GlassEdgeBrush" Color="#C7FFFFFF" />
        <SolidColorBrush x:Key="GlassLowerEdgeBrush" Color="#24364758" />
        <SolidColorBrush x:Key="SurfaceLightBrush" Color="#D9FFFFFF" />
        <SolidColorBrush x:Key="SurfaceDeepBrush" Color="#A8FFFFFF" />
        <SolidColorBrush x:Key="EdgeBrush" Color="#C7FFFFFF" />
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#243A715A" />
        <SolidColorBrush x:Key="PlaceholderBrush" Color="#7D8795" />
        <SolidColorBrush x:Key="CompletedBrush" Color="#5F6B7A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D84646" />
        <RadialGradientBrush x:Key="AmbientBlueBrush"
                             Center="0.5,0.5"
                             GradientOrigin="0.46,0.44">
            <GradientStop Offset="0" Color="#4C77BFFF" />
            <GradientStop Offset="0.62" Color="#2477BFFF" />
            <GradientStop Offset="1" Color="#0077BFFF" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientMintBrush"
                             Center="0.5,0.5"
                             GradientOrigin="0.44,0.52">
            <GradientStop Offset="0" Color="#586DCFA9" />
            <GradientStop Offset="0.64" Color="#286DCFA9" />
            <GradientStop Offset="1" Color="#006DCFA9" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientLilacBrush"
                             Center="0.5,0.5"
                             GradientOrigin="0.52,0.48">
            <GradientStop Offset="0" Color="#42B39DDB" />
            <GradientStop Offset="0.65" Color="#1FB39DDB" />
            <GradientStop Offset="1" Color="#00B39DDB" />
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="SurfaceBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Offset="0" Color="#F7F9FCFF" />
            <GradientStop Offset="0.52" Color="#EEF3F8FF" />
            <GradientStop Offset="1" Color="#EEF8F4FF" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Offset="0" Color="#477D67" />
            <GradientStop Offset="1" Color="#2F6250" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentHoverGradientBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Offset="0" Color="#3B6D59" />
            <GradientStop Offset="1" Color="#285443" />
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <Grid>
                                <Border x:Name="InteractionShade"
                                        Background="#140F172A"
                                        CornerRadius="11"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border x:Name="FocusRing"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="2"
                                        CornerRadius="11"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionShade" Property="Background" Value="#240F172A" />
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Background" Value="{StaticResource GlassSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <Border x:Name="InteractionShade"
                                        Background="#140F172A"
                                        CornerRadius="11"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                                <Border x:Name="FocusRing"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="2"
                                        CornerRadius="12"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionShade" Property="Background" Value="#240F172A" />
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15">
                            <Grid>
                                <Border x:Name="InteractionShade"
                                        Background="#120F172A"
                                        CornerRadius="15"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="InteractionShade" Property="Background" Value="#260F172A" />
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="18" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <Setter Property="Background" Value="#18FF3B30" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SlimScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="{TemplateBinding Width}"
                              Background="Transparent"
                              SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Focusable="False"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Orientation="Vertical"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="30"
                                           Cursor="SizeNS">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="ThumbSurface"
                                                            Width="4"
                                                            Margin="0,2"
                                                            HorizontalAlignment="Center"
                                                            Background="#66758291"
                                                            CornerRadius="2" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface"
                                                                Property="Background"
                                                                Value="{StaticResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface"
                                                                Property="Background"
                                                                Value="{StaticResource AccentPressedBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ThumbSurface" Property="Opacity" Value="0.35" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HistoryExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border x:Name="CardSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderToggle"
                                              Grid.Row="0"
                                              HorizontalContentAlignment="Stretch"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              Cursor="Hand"
                                              FocusVisualStyle="{x:Null}"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="HeaderSurface"
                                                    Background="Transparent"
                                                    CornerRadius="18">
                                                <Grid>
                                                    <Border x:Name="InteractionShade"
                                                            Background="#120F172A"
                                                            CornerRadius="18"
                                                            IsHitTestVisible="False"
                                                            Opacity="0" />
                                                    <ContentPresenter Margin="16,14"
                                                                      HorizontalAlignment="Stretch"
                                                                      VerticalAlignment="Center"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="InteractionShade" Property="Background" Value="#240F172A" />
                                                    <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="DetailHost"
                                        Grid.Row="1"
                                        Margin="16,0,16,14"
                                        Padding="0,13,0,0"
                                        BorderBrush="#28364758"
                                        BorderThickness="0,1,0,0"
                                        Visibility="Collapsed">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="DetailHost" Property="Visibility" Value="Visible" />
                                <Setter TargetName="CardSurface" Property="Background" Value="#D2FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{StaticResource ProgressTrackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StickyCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="32" Height="32">
                            <Border x:Name="Box"
                                    Width="24"
                                    Height="24"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource GlassElevatedBrush}"
                                    BorderBrush="#8094A3B8"
                                    BorderThickness="1.4"
                                    CornerRadius="8" />
                            <Path x:Name="CheckMark"
                                  Width="14"
                                  Height="11"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 1,6 L 5,10 L 13,1"
                                  Stroke="{StaticResource IvoryBrush}"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Fill"
                                  Visibility="Collapsed" />
                            <Border x:Name="FocusRing"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="#F0FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#D8FFFFFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
