                                                                    PreviewMouseLeftButtonDown="LabelDragHandle_PreviewMouseLeftButtonDown"
                                                                    PreviewMouseMove="LabelDragHandle_PreviewMouseMove"
                                                                    PreviewMouseLeftButtonUp="LabelDragHandle_PreviewMouseLeftButtonUp"
