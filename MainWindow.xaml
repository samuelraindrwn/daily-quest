<Window x:Class="DailyQuest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Copy.WindowTitle}"
        Icon="Assets/DailyQuest.ico"
        Width="520"
        Height="680"
        MinWidth="390"
        MinHeight="500"
        MaxWidth="1200"
        MaxHeight="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="{Binding AlwaysOnTop, Mode=OneWay}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Grid>
    <Grid x:Name="ExpandedWidget"
          Margin="14">
        <Border Background="{DynamicResource WindowBackingBrush}"
                CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Direction="270"
                                  Opacity="0.26"
                                  ShadowDepth="10"
                                  Color="{DynamicResource WindowShadowColor}" />
            </Border.Effect>
        </Border>

        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource EdgeBrush}"
                BorderThickness="1"
                CornerRadius="28">
            <Grid ClipToBounds="True">
                <Ellipse Width="240"
                         Height="240"
                         Margin="0,54,18,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource AmbientBlueBrush}"
                         IsHitTestVisible="False" />
                <Ellipse Width="230"
                         Height="230"
                         Margin="18,0,0,62"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Fill="{DynamicResource AmbientMintBrush}"
                         IsHitTestVisible="False" />
                <Ellipse Width="150"
                         Height="150"
                         Margin="0,0,48,32"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Fill="{DynamicResource AmbientLilacBrush}"
                         IsHitTestVisible="False" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="22,19,14,8"
                          Background="Transparent"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Greeting}"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="26"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="1,3,0,0"
                                       Text="{Binding FriendlyDate}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedInkBrush}"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding TogglePinCommand}"
                                    ToolTip="{Binding PinTooltip}"
                                    AutomationProperties.Name="{Binding Copy.PinWidgetAutomation}">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M 16,9 L 16,4 L 17,3 L 17,2 L 7,2 L 7,3 L 8,4 L 8,9 C 8,10.66 6.66,12 5,12 L 5,14 L 11,14 L 11,21 L 13,21 L 13,14 L 19,14 L 19,12 C 17.34,12 16,10.66 16,9 Z">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource MutedInkBrush}" />
                                                <Setter Property="Stretch" Value="Uniform" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlwaysOnTop}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="Compact_Click"
                                    ToolTip="{Binding Copy.CompactMode}"
                                    AutomationProperties.Name="{Binding Copy.CompactMode}">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="M 2,2 L 8,8 M 8,4 L 8,8 L 4,8 M 16,16 L 10,10 M 10,14 L 10,10 L 14,10"
                                          Stroke="{DynamicResource MutedInkBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          Stretch="Uniform" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="Minimize_Click"
                                    ToolTip="{Binding Copy.Minimize}"
                                    Content="&#x2212;"
                                    AutomationProperties.Name="{Binding Copy.Minimize}" />
                            <Button Click="Close_Click"
                                    ToolTip="{Binding Copy.Close}"
                                    Content="&#x00D7;"
                                    AutomationProperties.Name="{Binding Copy.Close}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource DangerTintBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,3,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="3"
                                Background="{DynamicResource SegmentTrayBrush}"
                                BorderBrush="{DynamicResource GlassEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,0,4,0"
                                        Command="{Binding ShowTodayCommand}"
                                        AutomationProperties.Name="{Binding Copy.TodayTab}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTodayView}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Copy.TodayTab}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTodayView}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Margin="0,0,4,0"
                                        Command="{Binding ShowHistoryCommand}"
                                        AutomationProperties.Name="{Binding Copy.HistoryTab}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHistoryView}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Copy.HistoryTab}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHistoryView}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Command="{Binding ShowUpcomingCommand}"
                                        AutomationProperties.Name="{Binding Copy.UpcomingTab}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUpcomingView}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Copy.UpcomingTab}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUpcomingView}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Width="18"
                                                Height="18"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                CornerRadius="9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpcomingQuests.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUpcomingView}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ActiveBadgeBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding UpcomingQuests.Count}"
                                                       Foreground="{DynamicResource AccentDarkBrush}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="2"
                                Width="50"
                                Height="42"
                                Padding="0"
                                Command="{Binding ShowSettingsCommand}"
                                ToolTip="{Binding Copy.SettingsTab}"
                                AutomationProperties.Name="{Binding Copy.SettingsTab}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
                                    <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="27" Height="27">
                                <TextBlock Text="&#x2699;"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Viewbox>
                        </Button>
                    </Grid>

                    <Border x:Name="ProgressSummaryCard"
                            Grid.Row="2"
                            Margin="20,0,20,14"
                            Padding="16,14"
                            Background="{DynamicResource GlassCardBrush}"
                            BorderBrush="{DynamicResource GlassEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility"
                                        Value="{Binding IsTodayView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=SchedulePopup}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=DurationPopup}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=LabelPopup}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressText}"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <ToggleButton x:Name="SortPickerButton"
                                              Grid.Column="1"
                                              Height="26"
                                              MaxWidth="122"
                                              Margin="8,-4,8,-4"
                                              Padding="9,0"
                                              Cursor="Hand"
                                              FocusVisualStyle="{x:Null}"
                                              PreviewMouseLeftButtonDown="SortPickerButton_PreviewMouseLeftButtonDown"
                                              Click="SortPickerButton_Click"
                                              ToolTip="{Binding Copy.SortQuests}"
                                              AutomationProperties.Name="{Binding Copy.SortQuests}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="SortSurface"
                                                    Padding="8,0"
                                                    Background="{DynamicResource GlassSubtleBrush}"
                                                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="11">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Margin="0,0,5,0"
                                                               VerticalAlignment="Center"
                                                               Text="&#x21C5;"
                                                               Foreground="{DynamicResource AccentDarkBrush}"
                                                               FontSize="11" />
                                                    <TextBlock VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Copy.SortManual}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsLabelSort}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Copy.SortLabel}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDurationAscendingSort}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Copy.SortShortest}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsDurationDescendingSort}" Value="True">
                                                                        <Setter Property="Text" Value="{Binding Copy.SortLongest}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SortSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                    <Setter TargetName="SortSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SortSurface" Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                                                    <Setter TargetName="SortSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                           Foreground="{DynamicResource AccentDarkBrush}"
                                           FontWeight="Bold"
                                           FontSize="13" />
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Margin="0,10,0,0"
                                         Style="{StaticResource GlassProgressBarStyle}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,9,0,0"
                                       Text="{Binding EncouragementText}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedInkBrush}"
                                       FontSize="12" />
                            <Popup x:Name="SortPopup"
                                   Grid.RowSpan="3"
                                   Width="{Binding ActualWidth, ElementName=ProgressSummaryCard}"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                   PlacementTarget="{Binding ElementName=ProgressSummaryCard}"
                                   Placement="Bottom"
                                   VerticalOffset="8"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   Opened="SortPopup_Opened"
                                   Closed="SortPopup_Closed"
                                   PopupAnimation="Fade">
                                <Border Padding="14"
                                        Background="{DynamicResource PopupSurfaceBrush}"
                                        BorderBrush="{DynamicResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24"
                                                          Direction="270"
                                                          Opacity="0.22"
                                                          ShadowDepth="8"
                                                          Color="{DynamicResource PopupShadowColor}" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Margin="3,0,3,9"
                                                   Text="{Binding Copy.SortQuests}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold" />
                                        <UniformGrid Rows="2" Columns="2">
                                            <Button Margin="3"
                                                    MinHeight="38"
                                                    Command="{Binding SetSortModeCommand}"
                                                    CommandParameter="manual"
                                                    Click="SortOption_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsManualSort}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Copy.SortManual}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                            <Button Margin="3"
                                                    MinHeight="38"
                                                    Command="{Binding SetSortModeCommand}"
                                                    CommandParameter="label"
                                                    Click="SortOption_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLabelSort}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Copy.SortLabel}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                            <Button Margin="3"
                                                    MinHeight="38"
                                                    Command="{Binding SetSortModeCommand}"
                                                    CommandParameter="duration-asc"
                                                    Click="SortOption_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDurationAscendingSort}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Copy.SortShortest}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                            <Button Margin="3"
                                                    MinHeight="38"
                                                    Command="{Binding SetSortModeCommand}"
                                                    CommandParameter="duration-desc"
                                                    Click="SortOption_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDurationDescendingSort}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                                                <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Copy.SortLongest}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3"
                          Margin="14,0,12,4"
                          Visibility="{Binding IsTodayView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer x:Name="TaskScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource SlimScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="TaskList" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="5,4,8,4"
                                                Padding="8,9"
                                                MinHeight="54"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                AllowDrop="{Binding DataContext.IsManualSort, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                DragOver="QuestCard_DragOver"
                                                DragLeave="QuestCard_DragLeave"
                                                Drop="QuestCard_Drop">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource CardHoverEdgeBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                 <Border Width="24"
                                                        Height="36"
                                                        Margin="0,0,3,0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        Cursor="SizeAll"
                                                         ToolTip="{Binding DataContext.Copy.ReorderActivity, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        AutomationProperties.Name="{Binding DataContext.Copy.ReorderActivity, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                         PreviewMouseMove="DragHandle_PreviewMouseMove"
                                                         PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsManualSort, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                             Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <UniformGrid Width="10"
                                                                 Height="17"
                                                                 Rows="3"
                                                                 Columns="2"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource TertiaryInkBrush}" />
                                                    </UniformGrid>
                                                </Border>
                                                <CheckBox Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource StickyCheckBoxStyle}"
                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding Text}" />
                                                <Grid Grid.Column="2"
                                                      Margin="10,0,7,0"
                                                      VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Text}"
