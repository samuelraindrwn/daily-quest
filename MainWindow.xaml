                                                                             VerticalAlignment="Center"
                                                                             Rows="3"
                                                                             Columns="2">
                                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TertiaryInkBrush}" />
                                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TertiaryInkBrush}" />
                                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TertiaryInkBrush}" />
                                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TertiaryInkBrush}" />
                                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TertiaryInkBrush}" />
                                                                    <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource TertiaryInkBrush}" />
                                                                </UniformGrid>
                                                            </Border>
                                                            <Button Grid.Column="1"
                                                                    Grid.RowSpan="2"
                                                                    Width="34"
                                                                    Height="34"
