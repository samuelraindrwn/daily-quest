                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Copy.ClearHistory}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Copy.ClearHistoryHint}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Padding="12,7"
                                                VerticalAlignment="Center"
                                                Click="ClearHistory_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                    <Setter Property="Background" Value="{DynamicResource DangerButtonBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistoryEntries.Count}" Value="0">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="{Binding Copy.ClearHistory}"
                                                       Foreground="{DynamicResource IvoryBrush}"
                                                       FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Padding="15"
                                        Background="{DynamicResource GlassCardBrush}"
                                        BorderBrush="{DynamicResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Copy.HelpTitle}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <Button Margin="0,11,0,7"
                                                Padding="12,9"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource SoftButtonStyle}"
                                                Click="OpenQna_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Copy.Qna}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding Copy.QnaHint}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedInkBrush}"
                                                               FontSize="10.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="&#x2197;"
                                                           Foreground="{DynamicResource AccentDarkBrush}" />
                                            </Grid>
                                        </Button>
                                        <Button Padding="12,9"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource SoftButtonStyle}"
                                                Click="OpenBugReport_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Copy.ReportBug}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding Copy.ReportBugHint}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedInkBrush}"
                                                               FontSize="10.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="&#x2197;"
                                                           Foreground="{DynamicResource AccentDarkBrush}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,16,0,0"
                                           HorizontalAlignment="Center"
                                           Text="{Binding FooterText}"
                                           Foreground="{DynamicResource TertiaryInkBrush}"
                                           FontSize="10.5" />
                                <TextBlock Margin="12,4,12,5"
                                           HorizontalAlignment="Center"
                                           Text="{Binding Copy.SettingsFooter}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TertiaryInkBrush}"
                                           FontSize="10.5" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Border Margin="1"
                        BorderBrush="{DynamicResource InnerHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="27"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
    <Grid x:Name="CompactWidget"
          Width="288"
          Height="64"
          Margin="6"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Visibility="Collapsed">
        <Border Background="{DynamicResource WindowBackingBrush}"
                CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  Direction="270"
                                  Opacity="0.25"
                                  ShadowDepth="5"
                                  Color="{DynamicResource WindowShadowColor}" />
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource EdgeBrush}"
                BorderThickness="1"
                CornerRadius="20"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid ClipToBounds="True">
                <Ellipse Width="125"
                         Height="125"
                         Margin="0,-48,-10,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="{DynamicResource AmbientBlueBrush}"
                         IsHitTestVisible="False" />
                <Ellipse Width="105"
                         Height="105"
                         Margin="-14,0,0,-52"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Fill="{DynamicResource AmbientMintBrush}"
                         IsHitTestVisible="False" />
                <Grid Margin="10,7,8,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding CompactDisplayItem}"
                                    VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              Style="{StaticResource StickyCheckBoxStyle}"
                                              IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                              Command="{Binding DataContext.CompleteItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                              CommandParameter="{Binding}"
                                              AutomationProperties.Name="{Binding Text}" />
                                    <StackPanel Grid.Column="1"
                                                Margin="7,0,6,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Text}"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Margin="0,2,0,0"
                                                    Orientation="Horizontal">
                                            <Border Height="16"
                                                    MaxWidth="72"
                                                    Margin="0,0,6,0"
                                                    Padding="6,0"
                                                    Background="{Binding LabelColorHex, Converter={StaticResource HexColorBrushConverter}}"
                                                    CornerRadius="8"
                                                    Visibility="{Binding HasLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding LabelName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding LabelColorHex, Converter={StaticResource HexColorBrushConverter}, ConverterParameter=foreground}"
                                                           FontSize="8.5"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding RemainingTimeText}"
                                                       Typography.NumeralAlignment="Tabular"
                                                       FontSize="9.5"
                                                       FontWeight="SemiBold"
                                                       Visibility="{Binding HasTimer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <TextBlock Margin="4,0,6,0"
                               VerticalAlignment="Center"
                               Text="{Binding Copy.CompactAllDone}"
                               Foreground="{DynamicResource MutedInkBrush}"
                               FontSize="13"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingItem}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Width="32"
                                Height="32"
                                Margin="0,0,5,0"
                                Command="{Binding TogglePinCommand}"
                                ToolTip="{Binding PinTooltip}"
                                AutomationProperties.Name="{Binding Copy.PinWidgetAutomation}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                    <Setter Property="Background" Value="{DynamicResource GlassCardBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AlwaysOnTop}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="13" Height="13">
                                <Path Data="M 16,9 L 16,4 L 17,3 L 17,2 L 7,2 L 7,3 L 8,4 L 8,9 C 8,10.66 6.66,12 5,12 L 5,14 L 11,14 L 11,21 L 13,21 L 13,14 L 19,14 L 19,12 C 17.34,12 16,10.66 16,9 Z">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource MutedInkBrush}" />
                                            <Setter Property="Stretch" Value="Uniform" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlwaysOnTop}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Viewbox>
                        </Button>
                        <Button Width="32"
                                Height="32"
                                Style="{StaticResource IconButtonStyle}"
                                Background="{DynamicResource GlassCardBrush}"
                                Click="Expand_Click"
                                ToolTip="{Binding Copy.ExpandMode}"
                                AutomationProperties.Name="{Binding Copy.ExpandMode}">
                            <Viewbox Width="14" Height="14">
                                <Path Data="M 2,8 L 2,2 L 8,2 M 2,2 L 8,8 M 16,10 L 16,16 L 10,16 M 16,16 L 10,10"
                                      Stroke="{DynamicResource AccentDarkBrush}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Margin="1"
                        BorderBrush="{DynamicResource InnerHighlightBrush}"
                        BorderThickness="1"
                        CornerRadius="19"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
    <Popup x:Name="ItemLabelPopup"
           Width="250"
           DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
           Placement="Bottom"
           VerticalOffset="6"
           AllowsTransparency="True"
           StaysOpen="False"
           PopupAnimation="Fade">
        <Border Padding="12"
                Background="{DynamicResource PopupSurfaceBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}"
                BorderThickness="1"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22"
                                  Direction="270"
                                  Opacity="0.22"
                                  ShadowDepth="7"
                                  Color="{DynamicResource PopupShadowColor}" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Margin="3,0,3,8"
                           Text="{Binding Copy.ChangeQuestLabel}"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <Button MinHeight="36"
                        Margin="3"
                        Padding="10,6"
                        HorizontalContentAlignment="Left"
                        Style="{StaticResource SoftButtonStyle}"
                        Click="ItemLabelNoneOption_Click">
                    <TextBlock Text="{Binding Copy.NoLabel}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               FontWeight="SemiBold" />
                </Button>
                <ScrollViewer MaxHeight="250"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Labels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button MinHeight="36"
                                        Margin="3"
                                        Padding="10,6"
                                        HorizontalContentAlignment="Left"
                                        Style="{StaticResource SoftButtonStyle}"
                                        Click="ItemLabelOption_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding ColorHex, Converter={StaticResource HexColorBrushConverter}}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Popup>
    </Grid>
</Window>
