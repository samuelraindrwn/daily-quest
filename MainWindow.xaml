                                                                        CornerRadius="10">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasLabel}" Value="True">
                                                                                    <Setter Property="Background" Value="{Binding LabelColorHex, Converter={StaticResource HexColorBrushConverter}}" />
