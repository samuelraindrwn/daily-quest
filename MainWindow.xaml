                                                                                <Setter Property="Text" Value="{Binding DataContext.Copy.NoLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource MutedInkBrush}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasLabel}" Value="True">
                                                                                        <Setter Property="Text" Value="{Binding LabelName}" />
                                                                                        <Setter Property="Foreground" Value="{Binding LabelColorHex, Converter={StaticResource HexColorBrushConverter}, ConverterParameter=foreground}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Grid Grid.Row="2"
                                                          Margin="0,7,0,0"
                                                          Visibility="{Binding HasTimer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Width="58"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding RemainingTimeText}"
                                                                   Typography.NumeralAlignment="Tabular"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsTimerExpired}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsOvertime}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <ProgressBar Grid.Column="1"
                                                                     Height="4"
                                                                     MinWidth="44"
                                                                     Margin="8,0"
                                                                     VerticalAlignment="Center"
                                                                     Minimum="0"
                                                                     Maximum="100"
                                                                     Value="{Binding TimerProgressPercent, Mode=OneWay}">
                                                            <ProgressBar.Style>
                                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource GlassProgressBarStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanStartOvertime}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ProgressBar.Style>
                                                        </ProgressBar>
                                                        <Button Grid.Column="2"
                                                                Height="26"
                                                                Margin="0,0,5,0"
                                                                Padding="9,0"
                                                                Command="{Binding DataContext.StartOvertimeCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding DataContext.Copy.StartOvertime, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                AutomationProperties.Name="{Binding DataContext.Copy.StartOvertime, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Setter Property="Background" Value="{DynamicResource DangerButtonBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding CanStartOvertime}" Value="True" />
                                                                                <Condition Binding="{Binding DataContext.OvertimeEnabled, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Value="True" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="{Binding DataContext.Copy.OvertimeButton, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                       Foreground="{DynamicResource IvoryBrush}"
                                                                       FontSize="9.5"
                                                                       FontWeight="SemiBold" />
                                                        </Button>
                                                        <Button Grid.Column="3"
                                                                Width="28"
                                                                Height="26"
                                                                Padding="0"
                                                                ToolTip="{Binding DataContext.Copy.ToggleTimer, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                AutomationProperties.Name="{Binding DataContext.Copy.ToggleTimer, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding CanStartOvertime}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock FontFamily="Segoe UI Symbol"
                                                                       FontSize="11"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#x25B6;" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsTimerRunning}" Value="True">
                                                                                <Setter Property="Text" Value="&#x2161;" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Button>
                                                        <Button Grid.Column="4"
                                                                Width="28"
                                                                Height="26"
                                                                Margin="5,0,0,0"
                                                                Padding="0"
                                                                Style="{StaticResource SoftButtonStyle}"
                                                                ToolTip="{Binding DataContext.Copy.ResetTimer, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                AutomationProperties.Name="{Binding DataContext.Copy.ResetTimer, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                Command="{Binding DataContext.ResetTimerCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="&#x21BA;"
                                                                       FontFamily="Segoe UI Symbol"
                                                                       FontSize="13"
                                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                                <Button Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        Content="&#x00D7;"
                                                        ToolTip="{Binding DataContext.Copy.DeleteActivity, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        AutomationProperties.Name="{Binding DataContext.Copy.DeleteActivity, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}" />
                                                <Border x:Name="DropBeforeIndicator"
                                                        Grid.ColumnSpan="4"
                                                        Height="3"
                                                        Margin="10,-11,10,0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed" />
                                                <Border x:Name="DropAfterIndicator"
                                                        Grid.ColumnSpan="4"
                                                        Height="3"
                                                        Margin="10,0,10,-11"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Bottom"
                                                        Background="{DynamicResource AccentBrush}"
                                                        CornerRadius="2"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Padding="24"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TaskList, Path=Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="52"
                                        Height="52"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource GlassCardBrush}"
                                        BorderBrush="{DynamicResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="26"
                                        IsHitTestVisible="False">
                                    <Viewbox Width="23" Height="23">
                                        <Path Data="M 12,1 L 14.3,9.7 L 23,12 L 14.3,14.3 L 12,23 L 9.7,14.3 L 1,12 L 9.7,9.7 Z"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Margin="0,11,0,0"
                                           Text="{Binding Copy.EmptyTitle}"
                                           HorizontalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           MaxWidth="270"
                                           Text="{Binding Copy.EmptyHint}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ComposerGrid"
                          Grid.Row="4"
                          Margin="20,8,20,10"
                          Visibility="{Binding IsTodayView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Row="0"
                                Grid.Column="0"
                                MinHeight="46"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource GlassElevatedBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=NewItemTextBox, Path=IsKeyboardFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBox x:Name="NewItemTextBox"
                                         Padding="15,11"
                                         MaxLength="120"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource InkBrush}"
                                         CaretBrush="{DynamicResource AccentDarkBrush}"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         SelectionOpacity="0.42"
                                         FontFamily="{StaticResource AppFont}"
                                         FontSize="14"
                                         Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="NewItemTextBox_KeyDown"
                                         ToolTip="{Binding Copy.NewItemTooltip}" />
                                <TextBlock Margin="16,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="{Binding Copy.NewItemPlaceholder}"
                                           Foreground="{DynamicResource PlaceholderBrush}"
                                           FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=NewItemTextBox, Path=Text.Length}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                        <ToggleButton x:Name="SchedulePickerButton"
                                      Grid.Column="0"
                                      Height="42"
                                      Margin="0,8,3,0"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      PreviewMouseLeftButtonDown="SchedulePickerButton_PreviewMouseLeftButtonDown"
                                      Click="SchedulePickerButton_Click"
                                      ToolTip="{Binding Copy.ScheduleFor}"
                                      AutomationProperties.Name="{Binding Copy.ScheduleFor}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ScheduleSurface"
                                            Background="{DynamicResource GlassElevatedBrush}"
                                            BorderBrush="{DynamicResource GlassEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Grid Margin="11,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding SelectedScheduleLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold" />
                                            <Path Grid.Column="1"
                                                  Width="9"
                                                  Height="5"
                                                  Margin="7,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Data="M 1,1 L 4.5,4.5 L 8,1"
                                                  Stroke="{DynamicResource AccentDarkBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ScheduleSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            <Setter TargetName="ScheduleSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ScheduleSurface" Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                                            <Setter TargetName="ScheduleSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ToggleButton x:Name="DurationPickerButton"
                                      Grid.Column="1"
                                      Height="42"
                                      Margin="3,8,3,0"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      PreviewMouseLeftButtonDown="DurationPickerButton_PreviewMouseLeftButtonDown"
                                      Click="DurationPickerButton_Click"
                                      ToolTip="{Binding Copy.DurationPickerTitle}"
                                      AutomationProperties.Name="{Binding Copy.DurationPickerTitle}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="DurationSurface"
                                            Background="{DynamicResource GlassElevatedBrush}"
                                            BorderBrush="{DynamicResource GlassEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="15">
                                        <Grid Margin="11,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                                <Grid Width="24" Height="24">
                                                    <Ellipse Margin="2"
                                                             Stroke="{DynamicResource AccentDarkBrush}"
                                                             StrokeThickness="1.8" />
                                                    <Path Data="M 12,6 L 12,12 L 16,14"
                                                          Stroke="{DynamicResource AccentDarkBrush}"
                                                          StrokeThickness="1.8"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round" />
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,6,0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding SelectedDurationLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold" />
                                            <Path Grid.Column="2"
                                                  Width="9"
                                                  Height="5"
                                                  VerticalAlignment="Center"
                                                  Data="M 1,1 L 4.5,4.5 L 8,1"
                                                  Stroke="{DynamicResource AccentDarkBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="DurationSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            <Setter TargetName="DurationSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="DurationSurface" Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                                            <Setter TargetName="DurationSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ToggleButton x:Name="LabelPickerButton"
                                      Grid.Column="2"
                                      Height="42"
                                      Margin="3,8,0,0"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      PreviewMouseLeftButtonDown="LabelPickerButton_PreviewMouseLeftButtonDown"
                                      Click="LabelPickerButton_Click"
                                      ToolTip="{Binding Copy.LabelPickerTitle}"
                                      AutomationProperties.Name="{Binding Copy.LabelPickerTitle}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="LabelSurface"
                                            Background="{DynamicResource GlassElevatedBrush}"
                                            BorderBrush="{DynamicResource GlassEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="15">
                                        <Grid Margin="10,0,9,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9"
                                                     Height="9"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding SelectedLabelColorHex, Converter={StaticResource HexColorBrushConverter}}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSelectedLabel}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1"
                                                       Margin="7,0,5,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding SelectedLabelName}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSelectedLabel}" Value="False">
                                                                <Setter Property="Text" Value="{Binding Copy.NoLabel}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Path Grid.Column="2"
                                                  Width="9"
                                                  Height="5"
                                                  VerticalAlignment="Center"
                                                  Data="M 1,1 L 4.5,4.5 L 8,1"
                                                  Stroke="{DynamicResource AccentDarkBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="LabelSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                            <Setter TargetName="LabelSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="LabelSurface" Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                                            <Setter TargetName="LabelSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="SchedulePopup"
                               Width="{Binding ActualWidth, ElementName=ComposerGrid}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               PlacementTarget="{Binding ElementName=ComposerGrid}"
                               Placement="Top"
                               VerticalOffset="-8"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               Opened="SchedulePopup_Opened"
                               Closed="SchedulePopup_Closed"
                               PopupAnimation="Fade">
                            <Border Padding="14"
                                    Background="{DynamicResource PopupSurfaceBrush}"
                                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24"
                                                      Direction="270"
                                                      Opacity="0.22"
                                                      ShadowDepth="8"
                                                      Color="{DynamicResource PopupShadowColor}" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Margin="3,0,3,10"
                                               Text="{Binding Copy.ScheduleFor}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ScheduleOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="3" Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button MinHeight="58"
                                                        Margin="3"
                                                        Padding="7,6"
                                                        Click="ScheduleOption_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                            <Setter Property="Background" Value="{DynamicResource GlassSubtleBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource IvoryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   Text="{Binding Label}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding DateText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   Opacity="0.72"
                                                                   FontSize="9.5" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup x:Name="DurationPopup"
                               Width="{Binding ActualWidth, ElementName=ComposerGrid}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               PlacementTarget="{Binding ElementName=ComposerGrid}"
                               Placement="Top"
                               VerticalOffset="-8"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               Opened="DurationPopup_Opened"
                               Closed="DurationPopup_Closed"
                               PopupAnimation="Fade">
                            <Border Padding="14"
                                    Background="{DynamicResource PopupSurfaceBrush}"
                                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24"
                                                      Direction="270"
                                                      Opacity="0.22"
                                                      ShadowDepth="8"
                                                      Color="{DynamicResource PopupShadowColor}" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Margin="3,0,3,3"
                                               Text="{Binding Copy.DurationPickerTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="3,0,3,9"
                                               Text="{Binding Copy.CustomDurationHint}"
                                               Foreground="{DynamicResource MutedInkBrush}"
                                               FontSize="10.5" />
                                    <ItemsControl ItemsSource="{Binding DurationOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="2" Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button MinHeight="38"
                                                        Margin="3"
                                                        Padding="7,5"
                                                        Style="{StaticResource SoftButtonStyle}"
                                                        Click="DurationOption_Click">
                                                    <Grid>
                                                        <TextBlock x:Name="TimedDurationLabel"
                                                                   HorizontalAlignment="Center"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                                            <Run Text="{Binding Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding DataContext.Copy.DurationMinuteSuffix, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock x:Name="NoTimerDurationLabel"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding DataContext.Copy.NoTimer, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   Visibility="Collapsed" />
                                                    </Grid>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="0">
                                                        <Setter TargetName="TimedDurationLabel" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="NoTimerDurationLabel" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="3,9,3,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border MinHeight="38"
                                                Background="{DynamicResource GlassElevatedBrush}"
                                                BorderBrush="{DynamicResource GlassEdgeBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <Grid>
                                                <TextBox x:Name="CustomDurationTextBox"
                                                         MaxLength="3"
                                                         Padding="11,7"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource InkBrush}"
                                                         CaretBrush="{DynamicResource AccentDarkBrush}"
                                                         PreviewTextInput="CustomDurationTextBox_PreviewTextInput"
                                                         KeyDown="CustomDurationTextBox_KeyDown" />
                                                <TextBlock Margin="12,0"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False"
                                                           Text="{Binding Copy.CustomDuration}"
                                                           Foreground="{DynamicResource PlaceholderBrush}"
                                                           FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ElementName=CustomDurationTextBox, Path=Text.Length}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <Button Grid.Column="1"
                                                MinWidth="80"
                                                Margin="8,0,0,0"
                                                Padding="12,7"
                                                Style="{StaticResource SoftButtonStyle}"
                                                Click="ApplyCustomDuration_Click"
                                                Content="{Binding Copy.ApplyDuration}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Popup x:Name="LabelPopup"
                               Width="{Binding ActualWidth, ElementName=ComposerGrid}"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               PlacementTarget="{Binding ElementName=ComposerGrid}"
                               Placement="Top"
                               VerticalOffset="-8"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               Opened="LabelPopup_Opened"
                               Closed="LabelPopup_Closed"
                               PopupAnimation="Fade">
                            <Border Padding="14"
                                    Background="{DynamicResource PopupSurfaceBrush}"
                                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24"
                                                      Direction="270"
                                                      Opacity="0.22"
                                                      ShadowDepth="8"
                                                      Color="{DynamicResource PopupShadowColor}" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Margin="3,0,3,9"
                                               Text="{Binding Copy.LabelPickerTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <Button MinHeight="38"
                                            Margin="3"
                                            Padding="10,6"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding SetSelectedLabelCommand}"
                                            CommandParameter="{x:Null}"
                                            Click="LabelOption_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedLabel}" Value="False">
                                                        <Setter Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding Copy.NoLabel}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding Labels}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button MinHeight="38"
                                                        Margin="3"
                                                        Padding="10,6"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding DataContext.SetSelectedLabelCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}"
                                                        Click="LabelOption_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ControlCheckedBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse Width="10"
                                                                 Height="10"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding ColorHex, Converter={StaticResource HexColorBrushConverter}}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   FontWeight="SemiBold" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Margin="3,9,3,1"
                                            MinHeight="36"
                                            Style="{StaticResource SoftButtonStyle}"
                                            Click="ManageLabels_Click">
                                        <TextBlock Text="{Binding Copy.ManageLabels}"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                   FontWeight="SemiBold" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                        </Grid>
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Width="46"
                                Height="46"
                                Margin="10,0,0,0"
                                Background="{DynamicResource AccentGradientBrush}"
                                Foreground="{DynamicResource IvoryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Command="{Binding AddItemCommand}"
                                ToolTip="{Binding Copy.AddActivity}"
                                AutomationProperties.Name="{Binding Copy.AddActivity}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AddSurface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{DynamicResource OnAccentEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Grid>
                                            <Border x:Name="InteractionShade"
                                                    Background="{DynamicResource AddInteractionBrush}"
                                                    CornerRadius="15"
                                                    IsHitTestVisible="False"
                                                    Opacity="0" />
                                            <Path Width="18"
                                                  Height="18"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 9,2 L 9,16 M 2,9 L 16,9"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  SnapsToDevicePixels="True" />
                                            <Border x:Name="FocusRing"
                                                    BorderBrush="{DynamicResource IvoryBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="15"
                                                    IsHitTestVisible="False"
                                                    Opacity="0" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="InteractionShade" Property="Background" Value="{DynamicResource AddInteractionPressedBrush}" />
                                            <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="AddSurface" Property="Opacity" Value="0.52" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="5"
                          Margin="20,0,20,18"
                          Visibility="{Binding IsTodayView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Copy.AutoSaveStatus}"
                                   Foreground="{DynamicResource MutedInkBrush}"
                                   Margin="0,0,8,0"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Height="34"
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Style="{StaticResource SoftButtonStyle}"
                                    Background="{DynamicResource GlassSubtleBrush}"
                                    Content="{Binding Copy.ClearCompleted}"
                                    Command="{Binding ClearCompletedCommand}" />
                            <Button Height="34"
                                    Padding="12,6"
                                    Style="{StaticResource SoftButtonStyle}"
                                    Background="{DynamicResource GlassSubtleBrush}"
                                    Content="{Binding Copy.Reset}"
                                    Command="{Binding ResetTodayCommand}"
                                    ToolTip="{Binding Copy.ResetTooltip}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Text="{Binding FooterText}"
                                   Foreground="{DynamicResource TertiaryInkBrush}"
                                   FontSize="10.5" />
                    </Grid>

                    <Grid Grid.Row="2"
                          Grid.RowSpan="4"
                          Margin="14,0,12,16"
                          Visibility="{Binding IsUpcomingView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="7,2,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Copy.UpcomingTitle}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding Copy.UpcomingHint}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedInkBrush}"
                                           FontSize="11.5" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    MinWidth="34"
                                    Height="28"
                                    Padding="9,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AccentTintBrush}"
                                    CornerRadius="14">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding UpcomingQuests.Count}"
                                           Foreground="{DynamicResource AccentDarkBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="11" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource SlimScrollBarStyle}" />
                                </ScrollViewer.Resources>
                                <ItemsControl x:Name="UpcomingList"
                                              ItemsSource="{Binding UpcomingQuests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="5,4,8,6"
                                                    Padding="12,11"
                                                    Background="{DynamicResource GlassCardBrush}"
                                                    BorderBrush="{DynamicResource GlassEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="17">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border MinWidth="76"
                                                            Padding="9,6"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource AccentTintBrush}"
                                                            CornerRadius="12">
                                                        <StackPanel>
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       Text="{Binding ScheduleLabel}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource AccentDarkBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       HorizontalAlignment="Center"
                                                                       Text="{Binding DateText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource MutedInkBrush}"
                                                                       FontSize="9.5" />
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Margin="12,0,8,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Text}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="14" />
                                                        <StackPanel Margin="0,4,0,0"
                                                                    Orientation="Horizontal">
                                                            <Border Height="18"
                                                                    MaxWidth="90"
                                                                    Margin="0,0,7,0"
                                                                    Padding="7,1"
                                                                    Background="{Binding LabelColorHex, Converter={StaticResource HexColorBrushConverter}}"
                                                                    CornerRadius="9"
                                                                    Visibility="{Binding HasLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock VerticalAlignment="Center"
                                                                           Text="{Binding LabelName}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{Binding LabelColorHex, Converter={StaticResource HexColorBrushConverter}, ConverterParameter=foreground}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Text="{Binding DurationText}"
                                                                       Foreground="{DynamicResource AccentDarkBrush}"
                                                                       FontSize="10.5"
                                                                       FontWeight="SemiBold"
                                                                       Visibility="{Binding HasTimer, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource DeleteButtonStyle}"
                                                            Content="&#x00D7;"
                                                            ToolTip="{Binding DataContext.Copy.RemoveScheduledQuest, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            AutomationProperties.Name="{Binding DataContext.Copy.RemoveScheduledQuest, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            Command="{Binding DataContext.RemoveScheduledQuestCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Padding="24"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=UpcomingList, Path=Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52"
                                            Height="52"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource GlassCardBrush}"
                                            BorderBrush="{DynamicResource GlassEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="26"
                                            IsHitTestVisible="False">
                                        <Viewbox Width="24" Height="24">
                                            <Grid Width="24" Height="24">
                                                <Rectangle Margin="3,5,3,3"
                                                           RadiusX="3"
                                                           RadiusY="3"
                                                           Stroke="{DynamicResource AccentBrush}"
                                                           StrokeThickness="1.7" />
                                                <Path Data="M 7,2 L 7,8 M 17,2 L 17,8 M 3,9 L 21,9 M 8,14 L 16,14 M 12,11 L 12,17"
                                                      Stroke="{DynamicResource AccentBrush}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Margin="0,11,0,0"
                                               Text="{Binding Copy.UpcomingEmptyTitle}"
                                               HorizontalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               MaxWidth="285"
                                               Text="{Binding Copy.UpcomingEmptyHint}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedInkBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2"
                          Grid.RowSpan="4"
                          Margin="14,0,12,16"
                          Visibility="{Binding IsHistoryView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource SlimScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="5,4,8,8"
                                                  Style="{StaticResource HistoryExpanderStyle}"
                                                  AutomationProperties.Name="{Binding DateText}"
                                                  AutomationProperties.HelpText="{Binding SummaryText}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DateText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   Text="{Binding SummaryText}"
                                                                   Foreground="{DynamicResource AccentDarkBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                        <Path Grid.Column="2"
                                                              Width="12"
                                                              Height="7"
                                                              Margin="10,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Data="M 1,1 L 6,6 L 11,1"
                                                              RenderTransformOrigin="0.5,0.5"
                                                              Stroke="{DynamicResource MutedInkBrush}"
                                                              StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Stretch="Uniform">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="0" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                                                                     Value="True">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="180" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1"
                                                                 Margin="0,10,0,0"
                                                                 Style="{StaticResource GlassProgressBarStyle}"
                                                                 Height="5"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                </Grid>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="1,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding StatusGlyph}"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontWeight="Bold"
                                                                       FontSize="14" />
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Text}"
                                                                           TextWrapping="Wrap"
                                                                           FontSize="13">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource CompletedBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
