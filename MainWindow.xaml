<Window x:Class="DailyQuest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Copy.WindowTitle}"
        Icon="Assets/DailyQuest.ico"
        Width="430"
        Height="610"
        MinWidth="430"
        MinHeight="480"
        MaxWidth="760"
        MaxHeight="1000"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        Topmost="{Binding AlwaysOnTop, Mode=OneWay}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
    <Grid x:Name="ExpandedWidget"
          Margin="14"
          RenderTransformOrigin="1,0">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Border Background="#FFF4F7FB"
                CornerRadius="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="34"
                                  Direction="270"
                                  Opacity="0.26"
                                  ShadowDepth="10"
                                  Color="#45121B2A" />
            </Border.Effect>
        </Border>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="1"
                CornerRadius="28">
            <Grid ClipToBounds="True">
                <Ellipse Width="240"
                         Height="240"
                         Margin="0,54,18,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="{StaticResource AmbientBlueBrush}"
                         IsHitTestVisible="False" />
                <Ellipse Width="230"
                         Height="230"
                         Margin="18,0,0,62"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Fill="{StaticResource AmbientMintBrush}"
                         IsHitTestVisible="False" />
                <Ellipse Width="150"
                         Height="150"
                         Margin="0,0,48,32"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Fill="{StaticResource AmbientLilacBrush}"
                         IsHitTestVisible="False" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="22,19,14,8"
                          Background="Transparent"
                          MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Greeting}"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="26"
                                       FontWeight="SemiBold" />
                            <TextBlock Margin="1,3,0,0"
                                       Text="{Binding FriendlyDate}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="13" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding TogglePinCommand}"
                                    ToolTip="{Binding PinTooltip}"
                                    AutomationProperties.Name="{Binding Copy.PinWidgetAutomation}">
                                <Viewbox Width="15" Height="15">
                                    <Path Data="M 16,9 L 16,4 L 17,3 L 17,2 L 7,2 L 7,3 L 8,4 L 8,9 C 8,10.66 6.66,12 5,12 L 5,14 L 11,14 L 11,21 L 13,21 L 13,14 L 19,14 L 19,12 C 17.34,12 16,10.66 16,9 Z">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{StaticResource MutedInkBrush}" />
                                                <Setter Property="Stretch" Value="Uniform" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlwaysOnTop}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="Compact_Click"
                                    ToolTip="{Binding Copy.CompactMode}"
                                    AutomationProperties.Name="{Binding Copy.CompactMode}">
                                <Viewbox Width="16" Height="16">
                                    <Path Data="M 2,2 L 8,8 M 8,4 L 8,8 L 4,8 M 16,16 L 10,10 M 10,14 L 10,10 L 14,10"
                                          Stroke="{StaticResource MutedInkBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          Stretch="Uniform" />
                                </Viewbox>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Click="Minimize_Click"
                                    ToolTip="{Binding Copy.Minimize}"
                                    Content="&#x2212;"
                                    AutomationProperties.Name="{Binding Copy.Minimize}" />
                            <Button Click="Close_Click"
                                    ToolTip="{Binding Copy.Close}"
                                    Content="&#x00D7;"
                                    AutomationProperties.Name="{Binding Copy.Close}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                <Setter Property="Background" Value="#18FF3B30" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="20,3,20,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="3"
                                Background="#66FFFFFF"
                                BorderBrush="{StaticResource GlassEdgeBrush}"
                                BorderThickness="1"
                                CornerRadius="18">
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="0,0,4,0"
                                        Command="{Binding ShowTodayCommand}"
                                        AutomationProperties.Name="{Binding Copy.TodayTab}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTodayView}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Copy.TodayTab}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTodayView}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Margin="0,0,4,0"
                                        Command="{Binding ShowHistoryCommand}"
                                        AutomationProperties.Name="{Binding Copy.HistoryTab}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHistoryView}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Copy.HistoryTab}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHistoryView}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Command="{Binding ShowUpcomingCommand}"
                                        AutomationProperties.Name="{Binding Copy.UpcomingTab}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SegmentButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUpcomingView}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Copy.UpcomingTab}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUpcomingView}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Width="18"
                                                Height="18"
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                CornerRadius="9">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Background" Value="#263A715A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpcomingQuests.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsUpcomingView}" Value="True">
                                                            <Setter Property="Background" Value="#32FFFFFF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding UpcomingQuests.Count}"
                                                       Foreground="{StaticResource AccentDarkBrush}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="2"
                                Width="50"
                                Height="42"
                                Padding="0"
                                Command="{Binding ShowSettingsCommand}"
                                ToolTip="{Binding Copy.SettingsTab}"
                                AutomationProperties.Name="{Binding Copy.SettingsTab}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                    <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                                    <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Viewbox Width="22" Height="22">
                                <TextBlock Text="&#x2699;"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
                            </Viewbox>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2"
                            Margin="20,0,20,14"
                            Padding="16,14"
                            Background="{StaticResource GlassCardBrush}"
                            BorderBrush="{StaticResource GlassEdgeBrush}"
                            BorderThickness="1"
                            CornerRadius="18"
                            Visibility="{Binding IsTodayView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ProgressText}"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                           Foreground="{StaticResource AccentDarkBrush}"
                                           FontWeight="Bold"
                                           FontSize="13" />
                            </Grid>
                            <ProgressBar Grid.Row="1"
                                         Margin="0,10,0,0"
                                         Style="{StaticResource GlassProgressBarStyle}"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressPercent, Mode=OneWay}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,9,0,0"
                                       Text="{Binding EncouragementText}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3"
                          Margin="14,0,12,4"
                          Visibility="{Binding IsTodayView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer x:Name="TaskScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource SlimScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="TaskList" ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="5,4,8,4"
                                                Padding="8,9"
                                                MinHeight="54"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                AllowDrop="True"
                                                DragOver="QuestCard_DragOver"
                                                DragLeave="QuestCard_DragLeave"
                                                Drop="QuestCard_Drop">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource GlassCardBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#D2FFFFFF" />
                                                            <Setter Property="BorderBrush" Value="#E8FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="24"
                                                        Height="36"
                                                        Margin="0,0,3,0"
                                                        VerticalAlignment="Center"
                                                        Background="Transparent"
                                                        Cursor="SizeAll"
                                                        ToolTip="{Binding DataContext.Copy.ReorderActivity, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        AutomationProperties.Name="{Binding DataContext.Copy.ReorderActivity, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                        PreviewMouseMove="DragHandle_PreviewMouseMove"
                                                        PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp">
                                                    <UniformGrid Width="10"
                                                                 Height="17"
                                                                 Rows="3"
                                                                 Columns="2"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center">
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource TertiaryInkBrush}" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource TertiaryInkBrush}" />
                                                    </UniformGrid>
                                                </Border>
                                                <CheckBox Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource StickyCheckBoxStyle}"
                                                          IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                          AutomationProperties.Name="{Binding Text}" />
                                                <TextBlock Grid.Column="2"
                                                           Margin="10,0,7,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Text}"
                                                           TextWrapping="Wrap"
                                                           FontSize="15">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                    <Setter Property="Foreground" Value="{StaticResource CompletedBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource DeleteButtonStyle}"
                                                        Content="&#x00D7;"
                                                        ToolTip="{Binding DataContext.Copy.DeleteActivity, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        AutomationProperties.Name="{Binding DataContext.Copy.DeleteActivity, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding}" />
                                                <Border x:Name="DropBeforeIndicator"
                                                        Grid.ColumnSpan="4"
                                                        Height="3"
                                                        Margin="10,-11,10,0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Top"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="2"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed" />
                                                <Border x:Name="DropAfterIndicator"
                                                        Grid.ColumnSpan="4"
                                                        Height="3"
                                                        Margin="10,0,10,-11"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Bottom"
                                                        Background="{StaticResource AccentBrush}"
                                                        CornerRadius="2"
                                                        IsHitTestVisible="False"
                                                        Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Padding="24"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=TaskList, Path=Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="52"
                                        Height="52"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="{StaticResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="26"
                                        IsHitTestVisible="False">
                                    <Viewbox Width="23" Height="23">
                                        <Path Data="M 12,1 L 14.3,9.7 L 23,12 L 14.3,14.3 L 12,23 L 9.7,14.3 L 1,12 L 9.7,9.7 Z"
                                              Fill="{StaticResource AccentBrush}"
                                              Stretch="Uniform" />
                                    </Viewbox>
                                </Border>
                                <TextBlock Margin="0,11,0,0"
                                           Text="{Binding Copy.EmptyTitle}"
                                           HorizontalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           MaxWidth="270"
                                           Text="{Binding Copy.EmptyHint}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4"
                          Margin="20,8,20,10"
                          Visibility="{Binding IsTodayView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border MinHeight="46"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource GlassElevatedBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=NewItemTextBox, Path=IsKeyboardFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <TextBox x:Name="NewItemTextBox"
                                         Padding="15,11"
                                         MaxLength="120"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource InkBrush}"
                                         CaretBrush="{StaticResource AccentDarkBrush}"
                                         FontFamily="{StaticResource AppFont}"
                                         FontSize="14"
                                         Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="NewItemTextBox_KeyDown"
                                         ToolTip="{Binding Copy.NewItemTooltip}" />
                                <TextBlock Margin="16,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Text="{Binding Copy.NewItemPlaceholder}"
                                           Foreground="{StaticResource PlaceholderBrush}"
                                           FontSize="14">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=NewItemTextBox, Path=Text.Length}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ToggleButton x:Name="SchedulePickerButton"
                                      Grid.Column="1"
                                      Width="118"
                                      Height="46"
                                      Margin="9,0,0,0"
                                      Cursor="Hand"
                                      FocusVisualStyle="{x:Null}"
                                      IsChecked="{Binding ElementName=SchedulePopup, Path=IsOpen, Mode=TwoWay}"
                                      ToolTip="{Binding Copy.ScheduleFor}"
                                      AutomationProperties.Name="{Binding Copy.ScheduleFor}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ScheduleSurface"
                                            Background="{StaticResource GlassElevatedBrush}"
                                            BorderBrush="{StaticResource GlassEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Grid Margin="11,0,10,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding SelectedScheduleLabel}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource InkBrush}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold" />
                                            <Path Grid.Column="1"
                                                  Width="9"
                                                  Height="5"
                                                  Margin="7,0,0,0"
                                                  VerticalAlignment="Center"
                                                  Data="M 1,1 L 4.5,4.5 L 8,1"
                                                  Stroke="{StaticResource AccentDarkBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ScheduleSurface" Property="Background" Value="#E7FFFFFF" />
                                            <Setter TargetName="ScheduleSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ScheduleSurface" Property="Background" Value="#EFFFFFFF" />
                                            <Setter TargetName="ScheduleSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="SchedulePopup"
                               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               PlacementTarget="{Binding ElementName=SchedulePickerButton}"
                               Placement="Top"
                               HorizontalOffset="-214"
                               VerticalOffset="-8"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border Width="342"
                                    Padding="14"
                                    Background="#F4F8FBFF"
                                    BorderBrush="{StaticResource GlassEdgeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24"
                                                      Direction="270"
                                                      Opacity="0.22"
                                                      ShadowDepth="8"
                                                      Color="#55121B2A" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Margin="3,0,3,10"
                                               Text="{Binding Copy.ScheduleFor}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding ScheduleOptions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="3" Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button MinHeight="58"
                                                        Margin="3"
                                                        Padding="7,6"
                                                        Click="ScheduleOption_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                            <Setter Property="Background" Value="{StaticResource GlassSubtleBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   Text="{Binding Label}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Margin="0,3,0,0"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding DateText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                                   Opacity="0.72"
                                                                   FontSize="9.5" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button Grid.Column="2"
                                Width="46"
                                Height="46"
                                Margin="10,0,0,0"
                                Background="{StaticResource AccentGradientBrush}"
                                Foreground="{StaticResource IvoryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}"
                                Command="{Binding AddItemCommand}"
                                ToolTip="{Binding Copy.AddActivity}"
                                AutomationProperties.Name="{Binding Copy.AddActivity}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AddSurface"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="#72FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Grid>
                                            <Border x:Name="InteractionShade"
                                                    Background="#160F172A"
                                                    CornerRadius="15"
                                                    IsHitTestVisible="False"
                                                    Opacity="0" />
                                            <Path Width="18"
                                                  Height="18"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Data="M 9,2 L 9,16 M 2,9 L 16,9"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  SnapsToDevicePixels="True" />
                                            <Border x:Name="FocusRing"
                                                    BorderBrush="{StaticResource IvoryBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="15"
                                                    IsHitTestVisible="False"
                                                    Opacity="0" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="InteractionShade" Property="Background" Value="#300F172A" />
                                            <Setter TargetName="InteractionShade" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="AddSurface" Property="Opacity" Value="0.52" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="5"
                          Margin="20,0,20,18"
                          Visibility="{Binding IsTodayView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Copy.AutoSaveStatus}"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   Margin="0,0,8,0"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Height="34"
                                    Margin="0,0,6,0"
                                    Padding="12,6"
                                    Style="{StaticResource SoftButtonStyle}"
                                    Background="{StaticResource GlassSubtleBrush}"
                                    Content="{Binding Copy.ClearCompleted}"
                                    Command="{Binding ClearCompletedCommand}" />
                            <Button Height="34"
                                    Padding="12,6"
                                    Style="{StaticResource SoftButtonStyle}"
                                    Background="{StaticResource GlassSubtleBrush}"
                                    Content="{Binding Copy.Reset}"
                                    Command="{Binding ResetTodayCommand}"
                                    ToolTip="{Binding Copy.ResetTooltip}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Text="{Binding FooterText}"
                                   Foreground="{StaticResource TertiaryInkBrush}"
                                   FontSize="10.5" />
                    </Grid>

                    <Grid Grid.Row="2"
                          Grid.RowSpan="4"
                          Margin="14,0,12,16"
                          Visibility="{Binding IsUpcomingView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="7,2,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Copy.UpcomingTitle}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding Copy.UpcomingHint}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="11.5" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    MinWidth="34"
                                    Height="28"
                                    Padding="9,0"
                                    VerticalAlignment="Top"
                                    Background="{StaticResource AccentTintBrush}"
                                    CornerRadius="14">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding UpcomingQuests.Count}"
                                           Foreground="{StaticResource AccentDarkBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="11" />
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.Resources>
                                    <Style TargetType="{x:Type ScrollBar}"
                                           BasedOn="{StaticResource SlimScrollBarStyle}" />
                                </ScrollViewer.Resources>
                                <ItemsControl x:Name="UpcomingList"
                                              ItemsSource="{Binding UpcomingQuests}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="5,4,8,6"
                                                    Padding="12,11"
                                                    Background="{StaticResource GlassCardBrush}"
                                                    BorderBrush="{StaticResource GlassEdgeBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="17">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border MinWidth="76"
                                                            Padding="9,6"
                                                            VerticalAlignment="Center"
                                                            Background="{StaticResource AccentTintBrush}"
                                                            CornerRadius="12">
                                                        <StackPanel>
                                                            <TextBlock HorizontalAlignment="Center"
                                                                       Text="{Binding ScheduleLabel}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource AccentDarkBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="11" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       HorizontalAlignment="Center"
                                                                       Text="{Binding DateText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource MutedInkBrush}"
                                                                       FontSize="9.5" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Margin="12,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Text}"
                                                               TextWrapping="Wrap"
                                                               FontSize="14" />
                                                    <Button Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource DeleteButtonStyle}"
                                                            Content="&#x00D7;"
                                                            ToolTip="{Binding DataContext.Copy.RemoveScheduledQuest, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            AutomationProperties.Name="{Binding DataContext.Copy.RemoveScheduledQuest, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            Command="{Binding DataContext.RemoveScheduledQuestCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Padding="24"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=UpcomingList, Path=Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52"
                                            Height="52"
                                            HorizontalAlignment="Center"
                                            Background="{StaticResource GlassCardBrush}"
                                            BorderBrush="{StaticResource GlassEdgeBrush}"
                                            BorderThickness="1"
                                            CornerRadius="26"
                                            IsHitTestVisible="False">
                                        <Viewbox Width="24" Height="24">
                                            <Grid Width="24" Height="24">
                                                <Rectangle Margin="3,5,3,3"
                                                           RadiusX="3"
                                                           RadiusY="3"
                                                           Stroke="{StaticResource AccentBrush}"
                                                           StrokeThickness="1.7" />
                                                <Path Data="M 7,2 L 7,8 M 17,2 L 17,8 M 3,9 L 21,9 M 8,14 L 16,14 M 12,11 L 12,17"
                                                      Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="1.7"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Grid>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Margin="0,11,0,0"
                                               Text="{Binding Copy.UpcomingEmptyTitle}"
                                               HorizontalAlignment="Center"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0"
                                               MaxWidth="285"
                                               Text="{Binding Copy.UpcomingEmptyHint}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2"
                          Grid.RowSpan="4"
                          Margin="14,0,12,16"
                          Visibility="{Binding IsHistoryView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource SlimScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="HistoryList" ItemsSource="{Binding HistoryEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="5,4,8,8"
                                                  Style="{StaticResource HistoryExpanderStyle}"
                                                  AutomationProperties.Name="{Binding DateText}"
                                                  AutomationProperties.HelpText="{Binding SummaryText}">
                                            <Expander.Header>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding DateText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1"
                                                                   Margin="8,0,0,0"
                                                                   Text="{Binding SummaryText}"
                                                                   Foreground="{StaticResource AccentDarkBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold" />
                                                        <Path Grid.Column="2"
                                                              Width="12"
                                                              Height="7"
                                                              Margin="10,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Data="M 1,1 L 6,6 L 11,1"
                                                              RenderTransformOrigin="0.5,0.5"
                                                              Stroke="{StaticResource MutedInkBrush}"
                                                              StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              StrokeLineJoin="Round"
                                                              Stretch="Uniform">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="0" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                                                                     Value="True">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="180" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                    <ProgressBar Grid.Row="1"
                                                                 Margin="0,10,0,0"
                                                                 Style="{StaticResource GlassProgressBarStyle}"
                                                                 Height="5"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Value="{Binding ProgressPercent, Mode=OneWay}" />
                                                </Grid>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="1,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding StatusGlyph}"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       FontWeight="Bold"
                                                                       FontSize="14" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Text}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="13">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                                                <Setter Property="Foreground" Value="{StaticResource CompletedBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Padding="24"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=HistoryList, Path=Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="52"
                                        Height="52"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="{StaticResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="26"
                                        IsHitTestVisible="False">
                                    <Viewbox Width="25" Height="25">
                                        <Grid Width="24" Height="24">
                                            <Ellipse Margin="2"
                                                     Stroke="{StaticResource AccentBrush}"
                                                     StrokeThickness="1.8" />
                                            <Path Data="M 12,6 L 12,12 L 16.5,14.5"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Grid>
                                    </Viewbox>
                                </Border>
                                <TextBlock Margin="0,11,0,0"
                                           Text="{Binding Copy.HistoryEmptyTitle}"
                                           HorizontalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,0"
                                           MaxWidth="270"
                                           Text="{Binding Copy.HistoryEmptyHint}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2"
                          Grid.RowSpan="4"
                          Margin="14,0,12,16"
                          Visibility="{Binding IsSettingsView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}"
                                       BasedOn="{StaticResource SlimScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <StackPanel Margin="6,3,8,4">
                                <TextBlock Margin="2,0,2,0"
                                           Text="{Binding Copy.SettingsTitle}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="2,4,2,14"
                                           Text="{Binding Copy.SettingsSubtitle}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="12" />

                                <Border Margin="0,0,0,10"
                                        Padding="15"
                                        Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="{StaticResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Copy.LanguageSetting}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <Grid Margin="0,11,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Height="38"
                                                    Margin="0,0,5,0"
                                                    Command="{Binding SetLanguageCommand}"
                                                    CommandParameter="id-ID">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                        <Setter Property="Background" Value="{StaticResource GlassSubtleBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIndonesian}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Copy.IndonesianLanguage}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                            <Button Grid.Column="1"
                                                    Height="38"
                                                    Margin="5,0,0,0"
                                                    Command="{Binding SetLanguageCommand}"
                                                    CommandParameter="en-US">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                        <Setter Property="Background" Value="{StaticResource GlassSubtleBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource IvoryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Copy.EnglishLanguage}"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           FontWeight="SemiBold" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,10"
                                        Padding="15"
                                        Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="{StaticResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Copy.StorageTitle}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Copy.ApplicationStorage}"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ApplicationStorageText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding Copy.DataStorage}"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding DataStorageText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding Copy.HistoryStorage}"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Margin="0,8,0,0"
                                                       Text="{Binding HistoryStorageText}"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Margin="0,11,0,0"
                                                   Text="{Binding Copy.StorageHint}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TertiaryInkBrush}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,10"
                                        Padding="15"
                                        Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="{StaticResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Copy.ClearHistory}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Copy.ClearHistoryHint}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       FontSize="11" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Padding="12,7"
                                                VerticalAlignment="Center"
                                                Content="{Binding Copy.ClearHistory}"
                                                Click="ClearHistory_Click">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistoryEntries.Count}" Value="0">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Padding="15"
                                        Background="{StaticResource GlassCardBrush}"
                                        BorderBrush="{StaticResource GlassEdgeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Copy.HelpTitle}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <Button Margin="0,11,0,7"
                                                Padding="12,9"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource SoftButtonStyle}"
                                                Click="OpenQna_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Copy.Qna}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding Copy.QnaHint}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource MutedInkBrush}"
                                                               FontSize="10.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="&#x2197;"
                                                           Foreground="{StaticResource AccentDarkBrush}" />
                                            </Grid>
                                        </Button>
                                        <Button Padding="12,9"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource SoftButtonStyle}"
                                                Click="OpenBugReport_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Copy.ReportBug}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding Copy.ReportBugHint}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource MutedInkBrush}"
                                                               FontSize="10.5" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="&#x2197;"
                                                           Foreground="{StaticResource AccentDarkBrush}" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,16,0,0"
                                           HorizontalAlignment="Center"
                                           Text="{Binding FooterText}"
                                           Foreground="{StaticResource TertiaryInkBrush}"
                                           FontSize="10.5" />
                                <TextBlock Margin="12,4,12,5"
                                           HorizontalAlignment="Center"
                                           Text="{Binding Copy.SettingsFooter}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TertiaryInkBrush}"
                                           FontSize="10.5" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <Border Margin="1"
                        BorderBrush="#AFFFFFFF"
                        BorderThickness="1"
                        CornerRadius="27"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
    <Grid x:Name="CompactWidget"
          Width="344"
          Height="92"
          Margin="8"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          RenderTransformOrigin="1,0"
          Visibility="Collapsed">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Border Background="#FFF4F7FB"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28"
                                  Direction="270"
                                  Opacity="0.25"
                                  ShadowDepth="8"
                                  Color="#45121B2A" />
            </Border.Effect>
        </Border>
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="1"
                CornerRadius="24"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid ClipToBounds="True">
                <Ellipse Width="170"
                         Height="170"
                         Margin="0,-65,-12,0"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Fill="{StaticResource AmbientBlueBrush}"
                         IsHitTestVisible="False" />
                <Ellipse Width="150"
                         Height="150"
                         Margin="-18,0,0,-75"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Fill="{StaticResource AmbientMintBrush}"
                         IsHitTestVisible="False" />
                <Grid Margin="15,12,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding NextPendingItem}"
                                    VerticalAlignment="Center">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Content" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center"
                                              Style="{StaticResource StickyCheckBoxStyle}"
                                              IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding Text}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,10,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Text}"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="14.5"
                                               FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                    <TextBlock Margin="6,0,10,0"
                               VerticalAlignment="Center"
                               Text="{Binding Copy.CompactAllDone}"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="14"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingItem}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconButtonStyle}"
                            Background="{StaticResource GlassCardBrush}"
                            Click="Expand_Click"
                            ToolTip="{Binding Copy.ExpandMode}"
                            AutomationProperties.Name="{Binding Copy.ExpandMode}">
                        <Viewbox Width="17" Height="17">
                            <Path Data="M 2,8 L 2,2 L 8,2 M 2,2 L 8,8 M 16,10 L 16,16 L 10,16 M 16,16 L 10,10"
                                  Stroke="{StaticResource AccentDarkBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform" />
                        </Viewbox>
                    </Button>
                </Grid>
                <Border Margin="1"
                        BorderBrush="#AFFFFFFF"
                        BorderThickness="1"
                        CornerRadius="23"
                        IsHitTestVisible="False" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
