                                    <StackPanel>
                                        <TextBlock Text="{Binding Copy.OvertimeSetting}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Copy.OvertimeHint}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedInkBrush}"
                                                   FontSize="11" />
                                        <Grid Margin="0,11,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
