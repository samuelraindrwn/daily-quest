                                                                        Click="DeleteLabel_Click"
                                                                        ToolTip="{Binding DataContext.Copy.DeleteLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                        AutomationProperties.Name="{Binding DataContext.Copy.DeleteLabel, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
                                                                            <Setter Property="Background" Value="{DynamicResource DangerButtonBrush}" />
