                                                                    Background="{DynamicResource AccentBrush}"
                                                                    CornerRadius="2"
                                                                    IsHitTestVisible="False"
                                                                    Visibility="Collapsed" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Margin="0,2,0,0"
